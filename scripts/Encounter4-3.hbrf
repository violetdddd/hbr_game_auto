# 2-附加 = 1; 美也: 0,0; nnm: 3,0; 司令: 3,0
# 2-od1 = 0; 美也: 2,0; nnm: 1,0; 司令: 0,0
# 2-od1-附加 = 0; 美也: 0,0; nnm: 2,0; 司令: 1,0
