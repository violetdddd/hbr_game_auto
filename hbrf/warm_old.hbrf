# 配队和技能（用于初始化角色编号为1-6）
tama: sp, 让道, 闪耀声援, 复活
麻里: sp, 场, 强化
aoi: sp, 无敌
绯雨: 全力枪击, 追加回合, 弱点, sp
鱼: 脆弱, sp, 大招
忍者: 连击, 冰加攻, 大招, sp
# 回合 = OD（后置1或2或3，0为不开od）; 队伍+技能（技能位置，指向角色编号）
skip
1 = 0; tama: 1,0; 麻里: 1,0; aoi: 1,0
change
2 = 0; tama: 1,0; 麻里: 1,0; aoi: 1,0
3 = 0; tama: 2,6; 麻里: 2,0; aoi: 2,0
4 = 0; 绯雨: 4,0; 鱼: 2,0; 忍者: 4,0
5 = 0; 绯雨: 1,0; aoi: 0,0; 忍者: 1,0
6 = 0; 麻里: 3,0; aoi: 0,0; 忍者: 1,0
7 = 0; tama: 0,0; aoi: 2,0; 忍者: 1,0
8 = 0; tama: 0,0; 鱼: 3,0; 绯雨: 1,0
9 = 0; 麻里: 3,0; aoi: 0,0; 忍者: 1,0
10 = 0; 绯雨: 1,0; aoi: 2,0; 忍者: 2,0
11 = 0; 绯雨: 0,0; 鱼: 0,0; tama: 4,0
12 = 0; 绯雨: 0,0; aoi: 0,0; 忍者: 2,0
13 = 0; 绯雨: 0,0; 鱼: 3,0; tama: 2,6
14 = 0; 绯雨: 0,0; aoi: 2,0; 忍者: 2,0
15 = 0; 绯雨: 0,0; aoi: 0,0; 忍者: 2,0
16 = 3; 绯雨: 2,0; 鱼: 1,0; tama: 0,0
追加回合 = 0; 绯雨: 3,0; 鱼: 0,0; tama: 0,0
OD1 = 0; 绯雨: 2,0; 鱼: 1,0; tama: 2,6
追加回合 = 0; 绯雨: 3,0; 鱼: 0,0; tama: 0,0
